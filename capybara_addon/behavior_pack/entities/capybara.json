{
  "format_version": "1.20.0",
  "minecraft:entity": {
    "description": {
      "identifier": "capybara:capybara",
      "is_spawnable": true,
      "is_summonable": true,
      "is_experimental": false
    },
    "component_groups": {
      "capybara:baby": {
        "minecraft:is_baby": {},
        "minecraft:scale": { "value": 0.5 },
        "minecraft:ageable": {
          "duration": 1200,
          "feed_items": ["capybara:orange"],
          "grow_up": {
            "event": "capybara:grow_up",
            "target": "self"
          }
        }
      },
      "capybara:adult": {
        "minecraft:scale": { "value": 1.0 },
        "minecraft:breedable": {
          "require_tame": false,
          "breed_items": ["capybara:orange"],
          "breed_cooldown": 300,
          "causes_pregnancy": false,
          "breeds_with": {
            "mate_type": "capybara:capybara",
            "baby_type": "capybara:capybara",
            "breed_event": {
              "event": "minecraft:entity_born",
              "target": "baby"
            }
          }
        }
      },
      "capybara:eating": {
        "minecraft:behavior.eat_carried_item": {
          "priority": 0,
          "delay_before_eating": 30
        }
      }
    },
    "components": {
      "minecraft:type_family": {
        "family": ["capybara", "animal", "mob"]
      },
      "minecraft:breathable": {
        "total_supply": 15,
        "suffocate_time": 0,
        "breathes_air": true,
        "breathes_water": false
      },
      "minecraft:collision_box": {
        "width": 1.2,
        "height": 0.9
      },
      "minecraft:nameable": {},
      "minecraft:health": {
        "value": 20,
        "max": 20
      },
      "minecraft:hurt_on_condition": {
        "damage_conditions": [
          {
            "filters": {
              "test": "in_lava",
              "subject": "self",
              "operator": "==",
              "value": true
            },
            "cause": "lava",
            "damage_per_tick": 4
          }
        ]
      },
      "minecraft:movement": { "value": 0.25 },
      "minecraft:movement.basic": {},
      "minecraft:jump.static": {},
      "minecraft:navigation.walk": {
        "can_path_over_water": false,
        "avoid_water": false,
        "can_sink": false
      },
      "minecraft:physics": {},
      "minecraft:pushable": {
        "is_pushable": true,
        "is_pushable_by_piston": true
      },
      "minecraft:leashable": {
        "soft_distance": 4.0,
        "hard_distance": 6.0,
        "max_distance": 10.0
      },
      "minecraft:follows_parent": {},
      "minecraft:experience_reward": {
        "on_death": "query.last_hit_by_player ? Math.Random(1,3) : 0"
      },
      "minecraft:loot": {
        "table": "loot_tables/entities/capybara.json"
      },
      "minecraft:despawn": {
        "despawn_from_distance": {}
      },
      "minecraft:behavior.look_at_player": {
        "priority": 7,
        "look_distance": 6,
        "probability": 0.02
      },
      "minecraft:behavior.random_look_around": {
        "priority": 9
      },
      "minecraft:behavior.random_stroll": {
        "priority": 6,
        "speed_multiplier": 0.8
      },
      "minecraft:behavior.random_swim": {
        "priority": 5,
        "speed_multiplier": 0.9,
        "xz_dist": 6,
        "y_dist": 3,
        "avoid_surface": false
      },
      "minecraft:behavior.tempt": {
        "priority": 3,
        "speed_multiplier": 1.25,
        "items": ["capybara:orange"],
        "can_get_scared": true
      },
      "minecraft:behavior.follow_parent": {
        "priority": 5,
        "speed_multiplier": 1.1
      },
      "minecraft:behavior.panic": {
        "priority": 1,
        "speed_multiplier": 1.5
      },
      "minecraft:behavior.flee_sun": {
        "priority": 2,
        "speed_multiplier": 1.0
      },
      "minecraft:behavior.mount_pathing": {
        "priority": 2,
        "speed_multiplier": 1.5,
        "target_dist": 0.0,
        "track_target": true
      },
      "minecraft:interact": {
        "interactions": [
          {
            "on_interact": {
              "filters": {
                "all_of": [
                  { "test": "has_equipment", "subject": "other", "domain": "hand", "value": "capybara:orange" },
                  { "test": "is_family", "subject": "other", "value": "player" }
                ]
              },
              "event": "capybara:fed_orange",
              "target": "self"
            },
            "use_item": true,
            "hurt_item": 0,
            "interact_text": "action.interact.feed"
          }
        ]
      },
      "minecraft:environment_sensor": {
        "triggers": [
          {
            "filters": {
              "test": "in_water",
              "operator": "==",
              "value": true
            },
            "event": "capybara:enter_water"
          }
        ]
      }
    },
    "events": {
      "capybara:entity_spawned": {
        "randomize": [
          {
            "weight": 90,
            "add": { "component_groups": ["capybara:adult"] }
          },
          {
            "weight": 10,
            "add": { "component_groups": ["capybara:baby"] }
          }
        ]
      },
      "minecraft:entity_born": {
        "add": { "component_groups": ["capybara:baby"] }
      },
      "capybara:grow_up": {
        "remove": { "component_groups": ["capybara:baby"] },
        "add": { "component_groups": ["capybara:adult"] }
      },
      "capybara:fed_orange": {
        "add": { "component_groups": ["capybara:eating"] }
      },
      "capybara:enter_water": {}
    }
  }
}
