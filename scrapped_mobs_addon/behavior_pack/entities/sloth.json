{
  "format_version": "1.20.0",
  "minecraft:entity": {
    "description": {
      "identifier": "scrapped:sloth",
      "is_spawnable": true,
      "is_summonable": true,
      "is_experimental": false
    },
    "component_groups": {
      "scrapped:sloth_adult": {
        "minecraft:experience_reward": { "on_death": "1+1*query.last_hurt_by_player" }
      },
      "scrapped:sloth_baby": {
        "minecraft:is_baby": {},
        "minecraft:scale": { "value": 0.5 },
        "minecraft:ageable": {
          "duration": 1200,
          "feed_items": ["apple", "sweet_berries"],
          "grow_up": { "event": "scrapped:sloth_grow_up", "target": "self" }
        }
      }
    },
    "components": {
      "minecraft:type_family": { "family": ["sloth", "animal", "mob"] },
      "minecraft:health": { "value": 12, "max": 12 },
      "minecraft:collision_box": { "width": 0.9, "height": 1.1 },
      "minecraft:movement": { "value": 0.08 },
      "minecraft:navigation.walk": { "can_path_over_water": false },
      "minecraft:movement.basic": {},
      "minecraft:nameable": {},
      "minecraft:despawn": { "despawn_from_distance": {} },
      "minecraft:loot": { "table": "loot_tables/entities/sloth.json" },
      "minecraft:behavior.float": { "priority": 0 },
      "minecraft:behavior.panic": { "priority": 1, "speed_multiplier": 0.7 },
      "minecraft:behavior.breed": { "priority": 3, "speed_multiplier": 0.6 },
      "minecraft:behavior.tempt": {
        "priority": 4,
        "speed_multiplier": 0.6,
        "items": ["apple", "sweet_berries"]
      },
      "minecraft:behavior.follow_parent": { "priority": 5, "speed_multiplier": 0.7 },
      "minecraft:behavior.random_stroll": { "priority": 6, "speed_multiplier": 0.5, "interval": 240 },
      "minecraft:behavior.look_at_player": { "priority": 7, "look_distance": 6 },
      "minecraft:behavior.random_look_around": { "priority": 8 },
      "minecraft:breedable": {
        "require_tame": false,
        "breed_items": ["apple", "sweet_berries"],
        "breeds_with": {
          "mate_type": "scrapped:sloth",
          "baby_type": "scrapped:sloth",
          "breed_event": { "event": "minecraft:entity_born", "target": "baby" }
        }
      },
      "minecraft:physics": {},
      "minecraft:pushable": { "is_pushable": true }
    },
    "events": {
      "minecraft:entity_spawned": { "add": { "component_groups": ["scrapped:sloth_adult"] } },
      "minecraft:entity_born": { "add": { "component_groups": ["scrapped:sloth_baby"] } },
      "scrapped:sloth_grow_up": {
        "remove": { "component_groups": ["scrapped:sloth_baby"] },
        "add": { "component_groups": ["scrapped:sloth_adult"] }
      }
    }
  }
}
