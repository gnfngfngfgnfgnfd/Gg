{
  "format_version": "1.20.0",
  "minecraft:entity": {
    "description": {
      "identifier": "scrapped:alpaca",
      "is_spawnable": true,
      "is_summonable": true,
      "is_experimental": false
    },
    "component_groups": {
      "scrapped:alpaca_adult": {
        "minecraft:experience_reward": {
          "on_death": "1+1*query.last_hurt_by_player"
        }
      },
      "scrapped:alpaca_baby": {
        "minecraft:is_baby": {},
        "minecraft:scale": { "value": 0.5 },
        "minecraft:ageable": {
          "duration": 1200,
          "feed_items": ["wheat", "hay_block"],
          "grow_up": {
            "event": "scrapped:alpaca_grow_up",
            "target": "self"
          }
        }
      }
    },
    "components": {
      "minecraft:type_family": { "family": ["alpaca", "animal", "mob"] },
      "minecraft:breathable": { "total_supply": 15, "suffocate_time": 0 },
      "minecraft:collision_box": { "width": 1.3, "height": 1.87 },
      "minecraft:nameable": {},
      "minecraft:health": { "value": 20, "max": 20 },
      "minecraft:hurt_on_condition": {
        "damage_conditions": [
          { "filters": { "test": "in_lava", "subject": "self", "operator": "==", "value": true }, "cause": "lava", "damage_per_tick": 4 }
        ]
      },
      "minecraft:movement": { "value": 0.18 },
      "minecraft:navigation.walk": { "can_path_over_water": true },
      "minecraft:movement.basic": {},
      "minecraft:jump.static": {},
      "minecraft:can_climb": {},
      "minecraft:despawn": { "despawn_from_distance": {} },
      "minecraft:behavior.float": { "priority": 0 },
      "minecraft:behavior.panic": { "priority": 1, "speed_multiplier": 1.25 },
      "minecraft:behavior.breed": { "priority": 3, "speed_multiplier": 1.0 },
      "minecraft:behavior.tempt": {
        "priority": 4,
        "speed_multiplier": 1.25,
        "items": ["wheat", "hay_block"]
      },
      "minecraft:behavior.follow_parent": { "priority": 5, "speed_multiplier": 1.1 },
      "minecraft:behavior.random_stroll": { "priority": 6, "speed_multiplier": 0.8 },
      "minecraft:behavior.look_at_player": { "priority": 7, "look_distance": 6 },
      "minecraft:behavior.random_look_around": { "priority": 8 },
      "minecraft:breedable": {
        "require_tame": false,
        "breed_items": ["wheat", "hay_block"],
        "breeds_with": {
          "mate_type": "scrapped:alpaca",
          "baby_type": "scrapped:alpaca",
          "breed_event": { "event": "minecraft:entity_born", "target": "baby" }
        }
      },
      "minecraft:loot": { "table": "loot_tables/entities/alpaca.json" },
      "minecraft:physics": {},
      "minecraft:pushable": { "is_pushable": true, "is_pushable_by_piston": true }
    },
    "events": {
      "minecraft:entity_spawned": {
        "randomize": [
          { "weight": 5, "add": { "component_groups": ["scrapped:alpaca_adult"] } },
          { "weight": 1, "add": { "component_groups": ["scrapped:alpaca_baby"] } }
        ]
      },
      "minecraft:entity_born": { "add": { "component_groups": ["scrapped:alpaca_baby"] } },
      "scrapped:alpaca_grow_up": {
        "remove": { "component_groups": ["scrapped:alpaca_baby"] },
        "add": { "component_groups": ["scrapped:alpaca_adult"] }
      }
    }
  }
}
